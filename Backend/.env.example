# Base de datos
DB_HOST=[localhost]
DB_PORT=[Puerto]
DB_USER=[DB_USER]
DB_PASSWORD=[DB_PASSWORD]
DB_NAME=[DB_NAME] # plataformaanticorrupcion
# Espera de conexión acotada; no cambia el tiempo máximo de una consulta.
DB_CONNECT_TIMEOUT_SECONDS=60
# Pool de diez conexiones. Para preparar diez antes de atender tráfico local:
# DB_POOL_MAX_OVERFLOW=0
# DB_POOL_PREWARM=10
# Omitir conserva el crecimiento de hasta veinte conexiones adicionales.
# La preparación está desactivada por defecto y requiere rol ordinario/local.
# Opcionales: omitir conserva la configuración del servidor. Solo /search y
# /metricas/top-proveedores; límite por transacción, no altera métricas/worker.
# Activar únicamente después de medir el perfil HTTP completo del equipo.
# SEARCH_QUERY_PARALLEL_WORKERS=0
# PROVIDER_QUERY_PARALLEL_WORKERS=0

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=pega_una_clave_aleatoria_de_al_menos_32_caracteres
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=resultado_del_comando_aqui
# Opcional y temporal durante una rotación: permite leer credenciales aún cifradas con la clave anterior.
# Retirar solo después de rotar y verificar todas las claves persistidas.
# ENCRYPTION_KEY_PREVIOUS=clave_fernet_anterior

# APScheduler
SCHEDULER_TIMEZONE=America/Bogota
# Orígenes exactos separados por coma; HTTPS en producción. No usar * ni rutas.
CORS_ORIGINS=http://localhost:5173
INGESTA_ALLOWED_HOSTS=www.datos.gov.co,datos.gov.co
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
INGESTA_OVERLAP_HOURS=48
INGESTA_MAX_RECORDS_PER_SYNC=100000
EXPORT_ARTIFACT_DIR=var/exports
EXPORT_MAX_ROWS=50000
EXPORT_CAPABILITY_TTL_HOURS=24
EXPORT_ARTIFACT_TTL_HOURS=24
